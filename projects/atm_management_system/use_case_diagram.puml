@startuml ATM Use Case Diagram
left to right direction
actor "Customer" as C

rectangle "ATM System" {
  (Withdraw Cash) : UC-01
  (Deposit Cash) : UC-02
  (Check Balance) : UC-03
  (Change PIN) : UC-04
  (Generate Mini Statement) : UC-05
  (Verify PIN) : UC-00 <<include>>
}

C -- (Withdraw Cash)
C -- (Deposit Cash)
C -- (Check Balance)
C -- (Change PIN)
C -- (Generate Mini Statement)

(Withdraw Cash) -[dashed]-> (Verify PIN) : <<include>>
(Deposit Cash) -[dashed]-> (Verify PIN) : <<include>>
(Check Balance) -[dashed]-> (Verify PIN) : <<include>>
(Change PIN) -[dashed]-> (Verify PIN) : <<include>>
(Generate Mini Statement) -[dashed]-> (Verify PIN) : <<include>>

note right of (Verify PIN)
  Validates customer PIN before processing
  any transaction (NFR-02: 3 failed attempts = account lock)
end note
@enduml