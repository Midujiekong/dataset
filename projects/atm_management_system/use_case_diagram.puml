@startuml
left to right direction

actor Customer

rectangle ATM_System {
  usecase "Register Account" as UC1
  usecase "Login" as UC2
  usecase "Withdraw Cash" as UC3
  usecase "Deposit Cash" as UC4
  usecase "Balance Enquiry" as UC5
  usecase "Mini Statement" as UC6
  usecase "Change PIN" as UC7
  usecase "Fast Cash" as UC8
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5
Customer --> UC6
Customer --> UC7
Customer --> UC8

UC3 .> UC2 : <<include>>
UC4 .> UC2 : <<include>>
UC5 .> UC2 : <<include>>
UC6 .> UC2 : <<include>>
UC7 .> UC2 : <<include>>
UC8 .> UC2 : <<include>>

@enduml