{
  "use_cases": [
    {
      "id": "UC-01",
      "name": "Register Account",
      "primary_actor": "Customer",
      "goal": "Create a new ATM account"
    },
    {
      "id": "UC-02",
      "name": "Login",
      "primary_actor": "Customer",
      "goal": "Authenticate using card number and PIN"
    },
    {
      "id": "UC-03",
      "name": "Withdraw Cash",
      "primary_actor": "Customer",
      "goal": "Withdraw money from ATM account",
      "preconditions": [
        "Customer is authenticated",
        "ATM system is connected to database"
      ],
      "postconditions": [
        "Account balance is updated",
        "Transaction is stored"
      ],
      "main_flow": [
        {
          "id": "MF-1",
          "actor": "Customer",
          "action": "Select Withdraw option"
        },
        {
          "id": "MF-2",
          "actor": "System",
          "action": "Prompt for withdrawal amount"
        },
        {
          "id": "MF-3",
          "actor": "Customer",
          "action": "Enter amount"
        },
        {
          "id": "MF-4",
          "actor": "System",
          "action": "Validate account balance"
        },
        {
          "id": "MF-5",
          "actor": "System",
          "action": "Deduct amount and store transaction"
        },
        {
          "id": "MF-6",
          "actor": "System",
          "action": "Display success message"
        }
      ],
      "alternative_flows": [
        {
          "id": "AF-1",
          "condition": "Insufficient balance",
          "steps": [
            {
              "actor": "System",
              "action": "Display insufficient balance error"
            }
          ]
        }
      ]
    }
  ]
