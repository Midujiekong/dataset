      "main_flow": [
        {
          "id": "MF-01",
          "actor": "Customer",
          "action": "Customer selects mini statement option"
        },
        {
          "id": "MF-02",
          "actor": "System",
          "action": "System retrieves transaction history"
        },
        {
          "id": "MF-03",
          "actor": "System",
          "action": "System displays recent transactions"
        }
      ],
      "alternative_flows": []
    }
  ]
}