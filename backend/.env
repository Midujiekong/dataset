# 启动时自动加载，无需每次 set DEEPSEEK_API_KEY
# API 連不上時設 USE_LLM=false 可改用規則評估（無需 LLM）
USE_LLM=true
# 若出現 Connection error，在內網/中國需設定代理，例如：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# incomplete chunked read：已將 timeout 增至 180s；可設 LLM_MAX_RETRIES=5 增加重試
MULTI_AGENT_ENABLED=true
# 加速選項（可選）：diagram_only=用例描述僅用單一模型，可大幅縮短評估時間
MULTI_AGENT_SCOPE=diagram_only
# 最多使用幾個模型（預設3，設為2可略為加速）
MULTI_AGENT_MAX_MODELS=3
DEEPSEEK_API_KEY=sk-89cc6f7543dc4485a29470ef3cc4f5a9
